// Russian (Symbian language code 16). Primary language.
// This file is UTF-8; the .rss declares CHARACTER_SET UTF8 so rcomp reads it correctly.

//d:Application caption in the phone menu.
rls_string STRING_r_symgram_caption "Symgram"

//d:Short caption, shown where space is tight.
rls_string STRING_r_symgram_short_caption "Symgram"

//d:Options menu, opens the about note.
rls_string STRING_r_symgram_menu_about "О программе"

//d:Options menu, closes the application.
rls_string STRING_r_symgram_menu_exit "Выход"

//d:Body of the about note, shown under the name and version.
rls_string STRING_r_symgram_about_text "Клиент Telegram для Symbian 9.2"

//d:Connection status shown in the header when there is no session.
rls_string STRING_r_symgram_status_offline "Нет соединения"

//d:Header status while the user is not signed in.
rls_string STRING_r_symgram_status_unsigned "Нет входа"

//d:Title of the sign-in screen. Shown until there is a Telegram session.
rls_string STRING_r_symgram_signin_title "Вход в Telegram"

//d:Explanation that sign-in does not exist yet.
rls_string STRING_r_symgram_signin_detail "Авторизация ещё не реализована"

//d:Shown in place of the chat list after sign-in, while it is empty.
rls_string STRING_r_symgram_empty_title "Чатов нет"

//d:Explanation under the empty list title.
rls_string STRING_r_symgram_empty_detail "Сетевая часть не реализована"

rls_string STRING_r_symgram_loc_resource_file "\\resource\\apps\\Symgram"
