    {
    items =
        {
        LBUF { txt = STRING_r_symgram_chat_1; },
        LBUF { txt = STRING_r_symgram_chat_2; },
        LBUF { txt = STRING_r_symgram_chat_3; },
        LBUF { txt = STRING_r_symgram_chat_4; },
        LBUF { txt = STRING_r_symgram_chat_5; },
        LBUF { txt = STRING_r_symgram_chat_6; },
        LBUF { txt = STRING_r_symgram_chat_7; }
        };
    }

