RESOURCE DIALOG r_symgram_password_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_DATA_QUERY
                {
                layout = EDataLayout;
                label = STRING_r_symgram_password_prompt;
                control = EDWIN
                    {
                    flags = EEikEdwinNoHorizScrolling;
                    width = 25;
                    maxlength = 128;
                    lines = 1;
                    avkon_flags = EAknEditorFlagNoT9;
                    default_input_mode = EAknEditorTextInputMode;
                    };
                };
            }
        };
    }

RESOURCE ARRAY r_symgram_countries
    {
    items =
        {
        LBUF { txt = STRING_r_symgram_cc_ru; },
        LBUF { txt = STRING_r_symgram_cc_by; },
        LBUF { txt = STRING_r_symgram_cc_kz; },
        LBUF { txt = STRING_r_symgram_cc_ua; },
        LBUF { txt = STRING_r_symgram_cc_de; },
        LBUF { txt = STRING_r_symgram_cc_us; },
        LBUF { txt = STRING_r_symgram_cc_gb; },
        LBUF { txt = STRING_r_symgram_cc_fi; }
        };
    }

RESOURCE AVKON_LIST_QUERY r_symgram_country_query
    {
    flags = EGeneralQueryFlags;
    softkeys = R_AVKON_SOFTKEYS_OK_CANCEL__OK;
    items =
        {
        AVKON_LIST_QUERY_DLG_LINE
            {
            control = AVKON_LIST_QUERY_CONTROL
                {
                listtype = EAknCtSinglePopupMenuListBox;
                listbox = AVKON_LIST_QUERY_LIST
                    {
                    flags = EAknListBoxSelectionList | EAknListBoxLoopScrolling;
                    height = 8;
                    array_id = r_symgram_countries;
                    };
                heading = STRING_r_symgram_field_country;
                };
            }
        };
    }

RESOURCE TBUF r_symgram_empty_title
