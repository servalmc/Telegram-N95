CHARACTER_SET UTF8

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <appinfo.rh>
#include <badef.rh>
#include "Symgram.hrh"
#include "Symgram.rls"

RESOURCE RSS_SIGNATURE
    {
    }

RESOURCE TBUF r_default_document_name
    {
    buf = "SYMG";
    }

RESOURCE EIK_APP_INFO
    {
    menubar = r_symgram_menubar;
    cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
    }

RESOURCE MENU_BAR r_symgram_menubar
    {
    titles =
        {
        MENU_TITLE { menu_pane = r_symgram_menu; }
        };
    }

RESOURCE MENU_PANE r_symgram_menu
    {
    items =
        {
        MENU_ITEM
            {
            command = ESymgramCmdAbout;
            txt = STRING_r_symgram_menu_about;
            },
        MENU_ITEM
            {
            command = EAknSoftkeyExit;
            txt = STRING_r_symgram_menu_exit;
            }
        };
    }

RESOURCE TBUF r_symgram_about_text
    {
    buf = STRING_r_symgram_about_text;
    }

RESOURCE TBUF r_symgram_status_offline
    {
    buf = STRING_r_symgram_status_offline;
    }

RESOURCE TBUF r_symgram_empty_hint
    {
    buf = STRING_r_symgram_empty_hint;
    }

// Placeholder dialogs for the list. Each entry packs four fields separated by a
// vertical bar, which the view splits on load: name, last message, time, unread.
