; TelegramN95.pkg - GCCE release build, self-signed
&EN

#{"Telegram-N95"},(0xE0A11E95),1,0,0

%{"Telegram-N95"}
:"Telegram-N95"

; Supported platforms. FP1 is the target; 3rd Edition is listed because
; a 9.1 binary also runs on 9.2.
[0x101F7961], 0, 0, 0, {"S60 3rd Edition devices"}
[0x102032BE], 0, 0, 0, {"S60 3rd Edition FP1 devices"}

; makesis in this SDK does not expand $(EPOCROOT), so these are written relative
; to the drive root, which resolves through the D:\Symbian junction as well.
"\Symbian\9.2\S60_3rd_FP1\epoc32\release\gcce\urel\TelegramN95.exe" -"!:\sys\bin\TelegramN95.exe"
"\Symbian\9.2\S60_3rd_FP1\epoc32\data\z\resource\apps\TelegramN95.rsc" -"!:\resource\apps\TelegramN95.rsc"
"\Symbian\9.2\S60_3rd_FP1\epoc32\data\z\private\10003a3f\import\apps\TelegramN95_reg.rsc" -"!:\private\10003a3f\import\apps\TelegramN95_reg.rsc"
