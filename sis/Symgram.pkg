; Symgram.pkg - GCCE release build, self-signed
; Language order below drives the {} blocks: first entry is Russian, second English.
&RU,EN

#{"Symgram","Symgram"},(0xE0A11E95),0,2,24

%{"Symgram","Symgram"}
:"Symgram"

; Supported platforms. FP1 is the target; 3rd Edition is listed because
; a 9.1 binary also runs on 9.2.
[0x101F7961], 0, 0, 0, {"S60 3rd Edition devices","S60 3rd Edition devices"}
[0x102032BE], 0, 0, 0, {"S60 3rd Edition FP1 devices","S60 3rd Edition FP1 devices"}

; makesis in this SDK does not expand $(EPOCROOT), so these are written relative
; to the drive root, which resolves through the D:\Symbian junction as well.
"\Symbian\9.2\S60_3rd_FP1\epoc32\release\gcce\urel\Symgram.exe" -"!:\sys\bin\Symgram.exe"

{
"\Symbian\9.2\S60_3rd_FP1\epoc32\data\z\resource\apps\Symgram.r16"
"\Symbian\9.2\S60_3rd_FP1\epoc32\data\z\resource\apps\Symgram.r01"
} -"!:\resource\apps\Symgram.rsc"

"\Symbian\9.2\S60_3rd_FP1\epoc32\data\z\private\10003a3f\import\apps\Symgram_reg.rsc" -"!:\private\10003a3f\import\apps\Symgram_reg.rsc"

; Application icon. Bitmap icons live in an .mbm; the .mif mifconv emits
; alongside it stays empty and is not shipped.
"\Symbian\9.2\S60_3rd_FP1\epoc32\data\z\resource\apps\Symgram_aif.mbm" -"!:\resource\apps\Symgram_aif.mbm"

"\Symbian\9.2\S60_3rd_FP1\epoc32\data\z\resource\apps\Symgram_emoji.mbm" -"!:\resource\apps\Symgram_emoji.mbm"
