TARGET            Symgram.exe
TARGETTYPE        exe
VERSION           0.2

// 0x100039CE is the standard UID2 for a GUI application.
// UID3 sits in the unprotected 0xE0000000-0xEFFFFFFF range so the package
// can be self-signed without a Symbian Signed certificate.
UID               0x100039CE 0xE0A11E95
SECUREID          0xE0A11E95

// S60 3rd: default 8KB, hard max 80KB. 0x14000 sits on the limit and some
// phones then hand the process an 8KB stack; handshake fails with -20.
EPOCSTACKSIZE     0x10000
EPOCHEAPSIZE      0x020000 0x800000

// All of these are user-grantable, which keeps self-signing possible.
CAPABILITY        NetworkServices ReadUserData WriteUserData UserEnvironment
VENDORID          0

SOURCEPATH        ..\src
SOURCE            Symgram.cpp
SOURCE            SymgramApplication.cpp
SOURCE            SymgramDocument.cpp
SOURCE            SymgramAppUi.cpp
SOURCE            SymgramAppView.cpp
SOURCE            SymgramSession.cpp
SOURCE            SymgramCrypto.cpp
SOURCE            SymgramInflate.cpp
SOURCE            SymgramStore.cpp

USERINCLUDE       ..\inc
SYSTEMINCLUDE     \epoc32\include

SOURCEPATH        ..\data

START RESOURCE    Symgram.rss
HEADER
TARGETPATH        resource\apps
END

START RESOURCE    Symgram_reg.rss
#ifdef WINSCW
TARGETPATH        \private\10003a3f\apps
#else
TARGETPATH        \private\10003a3f\import\apps
#endif
END

// SC is the fallback variant and carries Russian, the primary language.
// 16 is Russian, 01 is UK English.
LANG              SC 01 16

LIBRARY           euser.lib
LIBRARY           apparc.lib
LIBRARY           cone.lib
LIBRARY           eikcore.lib
LIBRARY           eikcoctl.lib
LIBRARY           eikdlg.lib
LIBRARY           avkon.lib
LIBRARY           commonengine.lib
LIBRARY           efsrv.lib
LIBRARY           estor.lib

// The chat list measures text itself, which needs the font classes; drawing
// alone got by on virtual calls through the graphics context.
LIBRARY           gdi.lib
LIBRARY           fbscli.lib
LIBRARY           bafl.lib
LIBRARY           esock.lib
LIBRARY           insock.lib
LIBRARY           commdb.lib
LIBRARY           hal.lib
LIBRARY           random.lib
LIBRARY           imageconversion.lib
LIBRARY           commonui.lib
LIBRARY           apmime.lib
LIBRARY           platformenv.lib
