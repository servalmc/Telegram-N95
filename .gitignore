# --- Symbian build artifacts ---
ABLD.BAT
abld.bat
*.UID.CPP
*.uid.cpp
*.o
*.lib
*.dso
*.sym
*.map
*.in
*.d
*.make
*.dep

# Generated from .rss / .mbm / .svg sources
*.rsg
*.rsc
*.r0*
*.mbg
*.mbm
*.mif

# Packaged installers
*.sis
*.sisx
*.SIS
*.SISX

# Self-signing credentials. The committed sis/selfsign.* pair is the upgrade
# identity: every .sisx must be signed with it, or the phone treats the
# package as a different app and the private session is lost.
*.key
*.cer
!sis/selfsign.key
!sis/selfsign.cer
.rnd

# Telegram API credentials. The committed header includes this file;
# copy inc/SymgramApiLocal.h.example and paste values from my.telegram.org.
inc/SymgramApiLocal.h

# Session blobs and emulator logs must never be published.
session.bin
**/session.bin
*.log

# Local build output
build/
epoc32/

# --- Carbide.c++ / Eclipse ---
.metadata/
.settings/
*.launch
*.cproject_backup
bin/

# --- Windows ---
Thumbs.db
Desktop.ini
*~
